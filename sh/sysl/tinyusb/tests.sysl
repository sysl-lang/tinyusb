module sh.sysl.tinyusb
@tests

import sh.sysl.tinyusb.descriptors
import sh.sysl.tinyusb.serial
import sh.sysl.tinyusb.sim

// The tests play a host against the simulated controller of the `sim` port, so the bytes asserted
// are what TinyUSB's own device stack answers, not what the binding believes it would.

struct TestClock
    ms: u32

impl Clock for TestClock
    now_ms(*self) -> u32 = self.ms

private var clock: TestClock = TestClock(0)

// Bring the device up on the simulated bus and run the stack once.
private boot()
    sim.reset()
    set_clock(&clock)
    assert(start_device(0))
    sim.bus_reset()
    task()

// Ask for descriptor `kind` and read the answer back from endpoint 0 into `out`; its length.
private fetch(out: []u8, kind: u8, index: u8, length: u16) -> usize
    sim.get_descriptor(kind, index, length)
    task()
    val n = sim.take(0x80, out).expect("the device queued no answer on endpoint 0")
    task()
    n

@test("the device descriptor the stack answers is the one built from the options")
device_descriptor_answer()
    boot()
    var got: [64]u8 = [0; 64]
    val n = fetch(got[..], 1, 0, 18)
    assert_eq(n, 18usize)
    for i in 0..<18 do assert_eq(got[i], descriptors.device[i])
    assert_eq(got[0], 18u8)
    assert_eq(got[1], 1u8)
